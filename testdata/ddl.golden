-- create indexes
ERROR: clickhouse: unique index "t_a_b_unique": ClickHouse has no unique constraints or foreign keys

-- create unique column
ERROR: schema: column "c": clickhouse: unique column "c": ClickHouse has no unique constraints or foreign keys

-- create skipping indexes
CREATE TABLE `t` (
  `id` Int64,
  `a` String,
  `at` DateTime,
  INDEX `t_a_index` (`a`) TYPE bloom_filter GRANULARITY 1,
  INDEX `t_at_index` (`at`) TYPE minmax GRANULARITY 1
) ENGINE = MergeTree ORDER BY (`id`);

-- create table options
CREATE TABLE `t` (
  `id` Int64,
  `at` DateTime DEFAULT now()
) ENGINE = ReplacingMergeTree(at) ORDER BY (id, at) PARTITION BY toYYYYMM(at) TTL at + INTERVAL 30 DAY SETTINGS index_granularity = 4096;

-- create no primary key
CREATE TABLE `t` (
  `line` String
) ENGINE = Log;

-- create nullable array
ERROR: schema: column "c": clickhouse: column "c": an Array cannot be Nullable; use an empty array

-- alter add, drop, rename
ALTER TABLE `t` ADD COLUMN `nick` Nullable(String);
ALTER TABLE `t` DROP COLUMN `old`;
ALTER TABLE `t` RENAME COLUMN `a` TO `b`;

-- alter change column
ALTER TABLE `t` MODIFY COLUMN `nick` String;

-- alter indexes
ALTER TABLE `t` ADD INDEX `t_nick_index` (`nick`) TYPE set(100) GRANULARITY 1;
ALTER TABLE `t` DROP INDEX `t_old_index`;

