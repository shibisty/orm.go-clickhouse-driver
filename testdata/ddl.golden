-- create boolean
CREATE TABLE `t` (
  `c` Bool DEFAULT true
) ENGINE = MergeTree ORDER BY tuple();

-- create char
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create string
CREATE TABLE `t` (
  `c` String DEFAULT 'x'
) ENGINE = MergeTree ORDER BY tuple();

-- create text
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create mediumText
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create longText
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create tinyText
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create tinyInteger
CREATE TABLE `t` (
  `c` Int8
) ENGINE = MergeTree ORDER BY tuple();

-- create smallInteger
CREATE TABLE `t` (
  `c` Int16
) ENGINE = MergeTree ORDER BY tuple();

-- create mediumInteger
CREATE TABLE `t` (
  `c` Int32
) ENGINE = MergeTree ORDER BY tuple();

-- create integer
CREATE TABLE `t` (
  `c` Int32 DEFAULT 0
) ENGINE = MergeTree ORDER BY tuple();

-- create bigInteger
CREATE TABLE `t` (
  `c` Int64
) ENGINE = MergeTree ORDER BY tuple();

-- create unsignedInteger
CREATE TABLE `t` (
  `c` UInt32
) ENGINE = MergeTree ORDER BY tuple();

-- create increments
CREATE TABLE `t` (
  `c` Int64
) ENGINE = MergeTree ORDER BY (`c`);

-- create id
CREATE TABLE `t` (
  `id` Int64
) ENGINE = MergeTree ORDER BY (`id`);

-- create decimal
CREATE TABLE `t` (
  `c` Decimal(10, 2)
) ENGINE = MergeTree ORDER BY tuple();

-- create double
CREATE TABLE `t` (
  `c` Float64
) ENGINE = MergeTree ORDER BY tuple();

-- create float
CREATE TABLE `t` (
  `c` Float64
) ENGINE = MergeTree ORDER BY tuple();

-- create date
CREATE TABLE `t` (
  `c` Date32
) ENGINE = MergeTree ORDER BY tuple();

-- create dateTime
CREATE TABLE `t` (
  `c` DateTime64(3)
) ENGINE = MergeTree ORDER BY tuple();

-- create dateTimeTz
CREATE TABLE `t` (
  `c` DateTime64(0, 'UTC')
) ENGINE = MergeTree ORDER BY tuple();

-- create time
ERROR: schema: column "c": clickhouse: time column "c": older servers have no Time type; store seconds in an integer or a DateTime

-- create timestamp
CREATE TABLE `t` (
  `c` DateTime DEFAULT now()
) ENGINE = MergeTree ORDER BY tuple();

-- create timestampTz
CREATE TABLE `t` (
  `c` Nullable(DateTime64(0, 'UTC'))
) ENGINE = MergeTree ORDER BY tuple();

-- create year
CREATE TABLE `t` (
  `c` UInt16
) ENGINE = MergeTree ORDER BY tuple();

-- create binary
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create json
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create jsonb
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create uuid
CREATE TABLE `t` (
  `c` UUID
) ENGINE = MergeTree ORDER BY tuple();

-- create ulid
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create enum
CREATE TABLE `t` (
  `c` Enum8('a' = 1, 'b' = 2)
) ENGINE = MergeTree ORDER BY tuple();

-- create set
CREATE TABLE `t` (
  `c` Array(LowCardinality(String))
) ENGINE = MergeTree ORDER BY tuple();

-- create macAddress
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create ipAddress
CREATE TABLE `t` (
  `c` String
) ENGINE = MergeTree ORDER BY tuple();

-- create geometry
ERROR: schema: column "c": clickhouse: spatial column "c" is not supported; use Point/Polygon through raw SQL

-- create vector
CREATE TABLE `t` (
  `c` Array(Float32)
) ENGINE = MergeTree ORDER BY tuple();

-- create comment
CREATE TABLE `t` (
  `c` String COMMENT 'it\'s'
) ENGINE = MergeTree ORDER BY tuple();

